# WhatsApp Bot Configuration
# Copy this file to .env and fill in your actual API keys

# ========== REQUIRED ==========
# Owner WhatsApp number (without @s.whatsapp.net), contoh: 6281234567890
OWNER_NUMBER=

# Google Gemini API Key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek / OpenRouter API Key — https://openrouter.ai/keys (atau https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# OpenWeather API Key — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ========== OPTIONAL ==========
# RapidAPI Key (untuk download IG/TikTok via RapidAPI)
RAPIDAPI_KEY=

# EXA API Key — https://exa.ai/
EXA_API_KEY=

# TMDB API Key — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Genius API Key (lyrics)
GENIUS_API_KEY=

# WA bot number (auto-set setelah login pertama)
BOT_NUMBER=

# ========== LOGGING ==========
# Log level: error, warn, info, all
LOG_LEVEL=info

# Environment: development, production
NODE_ENV=production

# ========== ADVANCED ==========
MAX_RETRIES=3
RETRY_DELAY=5000

# Rate limiting (token bucket)
RATE_LIMIT_TOKENS=5
RATE_LIMIT_REFILL_RATE=1000
RATE_LIMIT_MAX_TOKENS=5

# ========== SHOLAT API ==========
# Method ID untuk aladhan API (default 20 = Kemenag RI)
ALADHAN_METHOD=20
